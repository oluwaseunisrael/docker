# Used by docker-compose.yml to configure the Postgres container
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass
POSTGRES_DB=taskdb

# Used by the app when you run `node server.js` directly on your machine
# against a Postgres container exposed on localhost (e.g. via `docker compose up db`).
# NOTE: when the whole stack runs via `docker compose up`, docker-compose.yml
# overrides this for the app container so it can reach Postgres by its service
# name ("db") instead of "localhost" — that override is expected, not a bug.
DATABASE_URL=postgres://taskuser:taskpass@localhost:5432/taskdb

PORT=3000
